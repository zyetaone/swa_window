{
	"name": "aero-dynamicwindow",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "chmod +x node_modules/.bin/* 2>/dev/null || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"generate-textures": "bun run scripts/generate-textures.ts",
		"prefetch-tiles": "bun run scripts/prefetch-tiles.ts",
		"build-pmtiles": "bun run scripts/build-pmtiles.ts",
		"process-clouds": "bun run scripts/process-clouds.ts",
		"serve": "bun run server.ts",
		"start": "bun run build && bun run server.ts"
	},
	"devDependencies": {
		"@gltf-transform/core": "^4.4.0",
		"@gltf-transform/functions": "^4.4.0",
		"@google/genai": "^1.52.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/multicast-dns": "^7.2.4",
		"@vitest/ui": "^4.1.7",
		"bun-types": "^1.3.14",
		"happy-dom": "^20.9.0",
		"svelte": "^5.55.9",
		"svelte-check": "^4.4.8",
		"typescript": "^5.9.3",
		"vite": "^7.3.3",
		"vite-plugin-static-copy": "^3.4.0",
		"vitest": "^4.1.7"
	},
	"dependencies": {
		"@threlte/core": "^8.5.16",
		"@threlte/extras": "^9.19.0",
		"cesium": "^1.141.0",
		"multicast-dns": "^7.2.5",
		"postprocessing": "^6.39.1",
		"three": "^0.183.2"
	}
}
