# Optional — only needed if you want Ion terrain/imagery fallback in dev without local tiles.
# VITE_CESIUM_ION_TOKEN=

# Local tile cache directory (server-side). Default: data/tiles (or /opt/zyeta-aero/tiles on Pi).
# TILE_DIR=data/tiles

# Client tile base URL baked at build time. Default: /api/tiles
# VITE_TILE_SERVER_URL=/api/tiles

# Dev: proxy missing tiles from EOX/Esri/Carto. Only on when NODE_ENV=development;
# fails closed on an unset NODE_ENV so the Pi never silently reaches the internet.
# AERO_TILE_REMOTE_FALLBACK=0
